# Copie este arquivo para .env e ajuste os valores
# Windows (PowerShell): Copy-Item .env.example .env
# Windows (cmd): copy .env.example .env

# --- Backend (server) ---
# Porta preferida do backend (ele escolhe a próxima livre automaticamente)
PORT=3000

# Chave para assinar/verificar JWT de sessão (obrigatório para auth)
JWT_SECRET=dev-secret-change-me

# (Opcional) Banco de dados MySQL/MariaDB
# Se vazio, o servidor sobe e só loga warnings ao acessar o DB.
DATABASE_URL=

# --- OAuth (necessário apenas se você for usar login) ---
# IDs/URLs do provedor OAuth (valores reais vêm da sua plataforma)
VITE_APP_ID=
VITE_OAUTH_PORTAL_URL=
OAUTH_SERVER_URL=
OWNER_OPEN_ID=
OWNER_NAME=

# --- Expo / Metro (web) ---
# Porta preferida do Expo web (o script escolhe a próxima livre automaticamente)
EXPO_PORT=8081

# URL do backend (necessário principalmente no celular / Expo Go)
# Exemplo: http://192.168.0.10:3000
EXPO_PUBLIC_API_BASE_URL=

# --- Extras (opcional) ---
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
